# Local package built from this checkout: cd packaging/arch && makepkg -si
pkgname=hp-charge-limit-rs
pkgver=0.1.0
pkgrel=1
pkgdesc="Battery charge limiter via ACPI WMI"
arch=('x86_64')
license=('unknown')
depends=('acpi_call' 'gcc-libs' 'glibc')
makedepends=('cargo')
backup=('etc/hp-charge-limit-rs.conf')
options=('!debug')

_root="$startdir/../.."

prepare() {
  cd "$_root"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  cargo test --frozen --release
}

package() {
  cd "$_root"
  install -Dm755 target/release/hp-charge-limit-rs "$pkgdir/usr/bin/hp-charge-limit-rs"
  install -Dm644 packaging/hp-charge-limit-rs.service "$pkgdir/usr/lib/systemd/system/hp-charge-limit-rs.service"
  install -Dm644 packaging/hp-charge-limit-rs.conf "$pkgdir/etc/hp-charge-limit-rs.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
